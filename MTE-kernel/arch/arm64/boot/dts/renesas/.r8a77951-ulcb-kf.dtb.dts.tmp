   power-domains = <&sysc 32>;
   clocks = <&cpg 1 711>;
   resets = <&cpg 711>;
  };

  cmm1: cmm@fea50000 {
   compatible = "renesas,r8a7795-cmm",
         "renesas,rcar-gen3-cmm";
   reg = <0 0xfea50000 0 0x1000>;
   power-domains = <&sysc 32>;
   clocks = <&cpg 1 710>;

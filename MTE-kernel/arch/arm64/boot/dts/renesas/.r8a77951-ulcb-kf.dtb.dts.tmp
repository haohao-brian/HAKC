     dma-names = "rx", "tx";
    };
    ssi3: ssi-3 {
     interrupts = <0 373 4>;
     dmas = <&audma0 0x07>, <&audma1 0x08>;
     dma-names = "rx", "tx";
    };
    ssi4: ssi-4 {
     interrupts = <0 374 4>;
     dmas = <&audma0 0x09>, <&audma1 0x0a>;
     dma-names = "rx", "tx";
    };
    ssi5: ssi-5 {
     interrupts = <0 375 4>;
     dmas = <&audma0 0x0b>, <&audma1 0x0c>;
     dma-names = "rx", "tx";
    };
    ssi6: ssi-6 {
     interrupts = <0 376 4>;
     dmas = <&audma0 0x0d>, <&audma1 0x0e>;
     dma-names = "rx", "tx";
    };
    ssi7: ssi-7 {
     interrupts = <0 377 4>;
     dmas = <&audma0 0x0f>, <&audma1 0x10>;

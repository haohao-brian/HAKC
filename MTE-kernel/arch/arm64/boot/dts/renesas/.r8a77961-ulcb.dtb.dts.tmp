         <0 336 4>,
         <0 337 4>,
         <0 338 4>,
         <0 339 4>,
         <0 340 4>,
         <0 341 4>,
         <0 342 4>,
         <0 343 4>,
         <0 344 4>,
         <0 345 4>,
         <0 346 4>,
         <0 347 4>,
         <0 348 4>,
         <0 349 4>,
         <0 382 4>,
         <0 383 4>;
   interrupt-names = "error",
     "ch0", "ch1", "ch2", "ch3",
     "ch4", "ch5", "ch6", "ch7",
     "ch8", "ch9", "ch10", "ch11",
     "ch12", "ch13", "ch14", "ch15";
   clocks = <&cpg 1 501>;
   clock-names = "fck";
   power-domains = <&sysc 32>;
   resets = <&cpg 501>;
   #dma-cells = <1>;

    };
   };
  };

  cluster4-hsio3 {
   polling-delay-passive = <1000>;
   polling-delay = <5000>;
   thermal-sensors = <&tmu 5>;

   trips {
    clust4-hsio3-alert {
     temperature = <85000>;
     hysteresis = <2000>;
     type = "passive";
    };

    clust4-hsio3-crit {
     temperature = <95000>;
     hysteresis = <2000>;
     type = "critical";
    };
   };
  };

  cluster2-3 {
   polling-delay-passive = <1000>;
   polling-delay = <5000>;
   thermal-sensors = <&tmu 6>;

   trips {
    cluster2-3-alert {
     temperature = <85000>;
     hysteresis = <2000>;

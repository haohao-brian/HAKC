# 10 "arch/arm64/boot/dts/freescale/imx8mn-var-som-symphony.dts" 2

/ {
 model = "Variscite VAR-SOM-MX8MN Symphony evaluation board";
 compatible = "variscite,var-som-mx8mn-symphony", "variscite,var-som-mx8mn", "fsl,imx8mn";

 reg_usdhc2_vmmc: regulator-usdhc2-vmmc {
  compatible = "regulator-fixed";
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
  regulator-name = "VSD_3V3";
  regulator-min-microvolt = <3300000>;
  regulator-max-microvolt = <3300000>;
  gpio = <&gpio4 22 0>;
  enable-active-high;
 };

 gpio-keys {
  compatible = "gpio-keys";

  back {
   label = "Back";
   gpios = <&pca9534 1 1>;
   linux,code = <158>;
  };

  home {
   label = "Home";
   gpios = <&pca9534 2 1>;
   linux,code = <102>;
  };

  menu {
   label = "Menu";
   gpios = <&pca9534 3 1>;
   linux,code = <139>;
  };
 };

 leds {
  compatible = "gpio-leds";

  led {
   label = "Heartbeat";
   gpios = <&pca9534 0 1>;
   linux,default-trigger = "heartbeat";
  };
 };
};

&ethphy {
 reset-gpios = <&pca9534 5 0>;
};

&i2c2 {
 clock-frequency = <400000>;
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_i2c2>;
 status = "okay";

 pca9534: gpio@20 {
  compatible = "nxp,pca9534";
  reg = <0x20>;
  gpio-controller;
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_pca9534>;
  interrupt-parent = <&gpio1>;
  interrupts = <7 2>;
  #gpio-cells = <2>;
  wakeup-source;


  usb3-sata-sel-hog {
   gpio-hog;
   gpios = <4 0>;
   output-low;
   line-name = "usb3_sata_sel";
  };

  som-vselect-hog {
   gpio-hog;
   gpios = <6 0>;
   output-low;
   line-name = "som_vselect";
  };

  enet-sel-hog {
   gpio-hog;
   gpios = <7 0>;
   output-low;
   line-name = "enet_sel";
  };
 };

 extcon_usbotg1: typec@3d {
  compatible = "nxp,ptn5150";
  reg = <0x3d>;
  interrupt-parent = <&gpio1>;
  interrupts = <11 8>;
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_ptn5150>;
  status = "okay";
 };
};

&i2c3 {

 ft5x06_ts: touchscreen@38 {
  compatible = "edt,edt-ft5406";
  reg = <0x38>;
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_captouch>;
  interrupt-parent = <&gpio5>;
  interrupts = <4 4>;

  touchscreen-size-x = <800>;
  touchscreen-size-y = <480>;
  touchscreen-inverted-x;
  touchscreen-inverted-y;
 };

 rtc@68 {
  compatible = "dallas,ds1337";
  reg = <0x68>;
 };
};


&uart1 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_uart1>;
 status = "okay";
};


&uart3 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_uart3>;
 status = "okay";
};

&usbotg1 {
 disable-over-current;
 extcon = <&extcon_usbotg1>, <&extcon_usbotg1>;
};

&pinctrl_fec1 {
 fsl,pins = <
  0x068 0x2D0 0x000 0x0 0x0 0x3
  0x06C 0x2D4 0x4C0 0x0 0x1 0x3
  0x070 0x2D8 0x000 0x0 0x0 0x1f
  0x074 0x2DC 0x000 0x0 0x0 0x1f
  0x078 0x2E0 0x000 0x0 0x0 0x1f
  0x07C 0x2E4 0x000 0x0 0x0 0x1f
  0x09C 0x304 0x000 0x0 0x0 0x91
  0x098 0x300 0x000 0x0 0x0 0x91
  0x094 0x2FC 0x554 0x0 0x0 0x91
  0x090 0x2F8 0x57C 0x0 0x0 0x91
  0x084 0x2EC 0x000 0x0 0x0 0x1f
  0x08C 0x2F4 0x000 0x0 0x0 0x91
  0x088 0x2F0 0x574 0x0 0x0 0x91
  0x080 0x2E8 0x000 0x0 0x0 0x1f

 >;
};

&pinctrl_fec1_sleep {
 fsl,pins = <
  0x068 0x2D0 0x000 0x5 0x0 0x120
  0x06C 0x2D4 0x000 0x5 0x0 0x120
  0x070 0x2D8 0x000 0x5 0x0 0x120
  0x074 0x2DC 0x000 0x5 0x0 0x120
  0x078 0x2E0 0x000 0x5 0x0 0x120
  0x07C 0x2E4 0x000 0x5 0x0 0x120
  0x09C 0x304 0x000 0x5 0x0 0x120
  0x098 0x300 0x000 0x5 0x0 0x120
  0x094 0x2FC 0x000 0x5 0x0 0x120
  0x090 0x2F8 0x000 0x5 0x0 0x120
  0x084 0x2EC 0x000 0x5 0x0 0x120
  0x08C 0x2F4 0x000 0x5 0x0 0x120
  0x088 0x2F0 0x000 0x5 0x0 0x120
  0x080 0x2E8 0x000 0x5 0x0 0x120

 >;
};

&iomuxc {
 pinctrl_captouch: captouchgrp {
  fsl,pins = <
   0x1EC 0x454 0x000 0x5 0x0 0x16
  >;
 };

 pinctrl_i2c2: i2c2grp {
  fsl,pins = <
   0x21C 0x484 0x5D0 0x0 0x0 0x400001c3
   0x220 0x488 0x560 0x0 0x0 0x400001c3
  >;
 };

 pinctrl_pca9534: pca9534grp {
  fsl,pins = <
   0x044 0x2AC 0x000 0x0 0x0 0x16
  >;
 };

 pinctrl_ptn5150: ptn5150grp {
  fsl,pins = <
   0x054 0x2BC 0x000 0x0 0x0 0x16
  >;
 };

 pinctrl_reg_usdhc2_vmmc: regusdhc2vmmcgrp {
  fsl,pins = <
   0x1B4 0x41C 0x000 0x5 0x0 0x41
  >;
 };

 pinctrl_uart1: uart1grp {
  fsl,pins = <
   0x234 0x49C 0x4F4 0x0 0x0 0x140
   0x238 0x4A0 0x000 0x0 0x0 0x140
  >;
 };

 pinctrl_uart3: uart3grp {
  fsl,pins = <
   0x244 0x4AC 0x504 0x0 0x2 0x140
   0x248 0x4B0 0x000 0x0 0x0 0x140
  >;
 };
};
